{
  "name": "pharma-logbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Electronic equipment, instrument and area logbook for pharmaceutical manufacturing",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js",
    "migrate:prod": "node dist/db/migrate.js",
    "migrate": "tsx db/migrate.ts",
    "create-admin": "tsx db/create-admin.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "ci": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^8.3.0",
    "@foliojs-fork/fontkit": "^1.9.2",
    "fastify": "^5.12.7",
    "pdfmake": "^0.2.23",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pdfmake": "^0.2.13",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
